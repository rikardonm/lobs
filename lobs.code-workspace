{
	"folders": [
		{
			"path": "."
		}
	],
	"settings": {
		"files.associations": {
			"*.toml": "ini"
		},
		"flake8.args": [
			"--max-line-length=120",
		],
		"black-formatter.args": [
			"--line-length",
			"120",
			"--target-version",
			"py312"
		],
		"explorer.excludeGitIgnore": true,
		"files.exclude": {
			"**/.git": true,
			"**/.svn": true,
			"**/.hg": true,
			"**/.DS_Store": true,
			"**/Thumbs.db": true,
		},
		"[python]": {
			"editor.defaultFormatter": "ms-python.black-formatter"
		}
	}
}
